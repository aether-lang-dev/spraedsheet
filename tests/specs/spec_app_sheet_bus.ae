// spec_app_sheet_bus.ae — demo 18 as an app, driven over the control bus as
// the Tauri spreadsheet's clients drive it: each request a string of REXX
// (SETCELL, GETCELL), answered with what it came to.
//   ./run-tests.sh spec_app_sheet_bus
import std.spec
import std.string
import saedriver as b
import griddriver as g
import uidriver
import busclient (courier_, command_)

main() {
    fw = spec.init()
    uidriver.wait_server()
    spec.describe(fw, "demo 18 over the control bus") {
        spec.it("SETCELL from another program sets the cell, and the sheet shows it") callback {
            spec.assert_true(b.wait_for_console("sae: control bus: listening"), "listening")
            url, key = courier_()
            spec.assert_true(string.ends_with(url, "/api/spreadsheet") == 1, "at the app's name")
            status, plain = command_(key, "SETCELL(\"A1\", \"100\")")
            spec.assert_str_eq(status, "HTTP/1.1 200 OK", "answered")
            spec.assert_contains(plain, "\"success\":true", "succeeded")
            spec.assert_contains(plain, "\"result\":\"100\"", "what was set")
            spec.assert_true(g.wait_cell("A", 1, "100"), "on the sheet")
        }
        spec.it("GETCELL reads it back; a formula ripples; a bad command says why") callback {
            _u, key = courier_()
            _s1, _p1 = command_(key, "SETCELL(\"B1\", \"=A1*2\")")
            _s2, got = command_(key, "GETCELL(\"B1\")")
            spec.assert_contains(got, "\"result\":200", "B1 = A1*2")
            _s3, bad = command_(key, "NOSUCHFUNCTION(1)")
            spec.assert_contains(bad, "\"success\":false", "refused")
        }
        spec.it("the same workload through the bus and through the ui comes to the same sheet, cell for cell") callback {
            _u, key = courier_()
            // Through the bus, on a sheet of its own.
            _a1, _p1 = command_(key, "ADDSHEET(\"ViaBus\")")
            _a2, _p2 = command_(key, "SETACTIVESHEET(\"ViaBus\")")
            _a3, _p3 = command_(key, "SETCELL(\"A1\", \"3\")")
            _a4, _p4 = command_(key, "SETCELL(\"A2\", \"4\")")
            _a5, _p5 = command_(key, "SETCELL(\"A3\", \"=A1*A2\")")
            _a6, _p6 = command_(key, "SETCELL(\"B1\", \"pears\")")
            _a7, _p7 = command_(key, "RUN_PROGRAM('ADDRESS SHEET \"format.font range=A3 bold=1\"')")
            _a8, bus = command_(key, "INSPECTCELLS(\"A1:B3\")")
            // Through the ui, on another: the Name Box and the formula
            // bar, and the Looks panel's Bold.
            g.command("sheet.add name=ViaUI")
            g.enter("A1", "3")
            g.enter("A2", "4")
            g.enter("A3", "=A1*A2")
            g.enter("B1", "pears")
            spec.assert_true(g.wait_cell("A", 3, "12"), "worked out in the ui")
            g.command("view.panel name=looks")
            g.goto("A3")
            b.click("Bold")
            spec.assert_true(b.wait_for_console("sheet: A3: bold"), "made bold")
            g.command("view.panel name=none")
            _a9, ui = command_(key, "INSPECTCELLS(\"A1:B3\")")
            spec.assert_contains(bus, "\"success\":true", "the bus's read")
            spec.assert_contains(bus, "bold", "the look read too")
            spec.assert_str_eq(ui, bus, "the same cells: inputs, values, looks")
        }
    }
    return spec.run_summary(fw)
}
