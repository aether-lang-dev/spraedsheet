// spec_sheet_large.ae -- larger-grid interaction (docs/comparisons/LIBREOFFICE.md
// action 6): a column of 20,000 rows, moved over by the keyboard alone. A page of its
// own: spec_sheet's page is full of sixty sheets by its end and 20,000 cells do
// not fit the memory it is given.
//
//   ./run-tests.sh spec_sheet_large
import std.spec
import std.string
import saedriver as b
import griddriver as g
import uidriver

// Waits for the cell at column A, row `row`, to be drawn (the grid brings it in after a jump).
shown_a(row: int) {
    i = 0
    while i < 60 && g.cell_id("A", row) == 0 {
        sleep(50)
        i = i + 1
    }
}

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "spreadsheet: a large column") {
        spec.it("Ctrl+Down jumps the 20,000 rows, Ctrl+Shift+Down selects them and the status bar counts them, Ctrl+End and Ctrl+Home come back") callback {
            b.navigate(b.test_url("/sheet"))
            spec.assert_true(b.wait_for_text("A1: (empty)"), "the sheet is up")
            g.command("cell.set cell=A1 input=1")
            g.command("cell.set cell=A2 input=2")
            g.command("edit.fillSeries range=A1:A20000")
            g.goto("A20000")
            spec.assert_true(b.wait_for_text("A20000: 20000 → 20000"), "the series reaches row 20,000")
            g.goto("A1")
            spec.assert_true(b.wait_for_text("A1: 1 → 1"), "back at A1")
            shown_a(1)
            g.pick("A", 1)
            g.key("Ctrl+Down")
            spec.assert_true(b.wait_for_text("A20000: 20000 → 20000"), "Ctrl+Down: the last row of the data")
            g.key("Ctrl+Up")
            spec.assert_true(b.wait_for_text("A1: 1 → 1"), "Ctrl+Up: back to the first")
            g.key("Ctrl+Shift+Down")
            spec.assert_true(uidriver.wait_body_contains("/widgets", "Count: 20000  Numerical Count: 20000", 40), "Ctrl+Shift+Down: the whole column selected, counted in the status bar")
            g.goto("A1")
            shown_a(1)
            g.pick("A", 1)
            g.key("Ctrl+End")
            spec.assert_true(b.wait_for_text("A20000: 20000 → 20000"), "Ctrl+End: the last cell used")
            g.key("Ctrl+Home")
            spec.assert_true(b.wait_for_text("A1: 1 → 1"), "Ctrl+Home: A1")
        }
    }
    return spec.run_summary(fw)
}
